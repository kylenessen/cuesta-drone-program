# macOS
.DS_Store

# Basecamp integration state and local config
.basecamp/
basecamp.toml

# Word lock files
~$*.docx

# Obsidian: share config (theme, plugins, settings) across devices,
# but ignore per-device UI state so it does not churn in commits.
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache
**/.obsidian/*.log

# Google Docs review integration state and local config
.gdocs/
gdocs.toml

# Compiled review documents
build/

# Python bytecode
__pycache__/
