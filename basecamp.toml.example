[basecamp]
# These IDs are visible in the Basecamp API.
# They are not secrets, but keep them local if you prefer.
account_id = 123
project_id = 456
vault_id = 789

# Basecamp requires a User-Agent for API calls.
# If you want to include contact info, you can use an email or a URL.
user_agent = "cuesta-drone-program (contact@example.com)"

[oauth]
# OAuth app credentials from Basecamp.
# Store the client_secret only in your local credentials file if you prefer.
client_id = "YOUR_CLIENT_ID"
client_secret = "YOUR_CLIENT_SECRET"

# Must match the redirect configured in the Basecamp integration.
redirect_uri = "http://127.0.0.1:8123/callback"

